# Unity .gitattributes
# Normalizes line endings, routes Unity YAML through UnityYAMLMerge, and
# tracks binary assets with Git LFS.

# Auto-detect text files and normalize to LF in the repo, native on checkout.
* text=auto

## Unity YAML — text, but must never be merged line-by-line by git.
## Requires the merge driver configured in .git/config (see README/CLAUDE.md).
*.unity           merge=unityyamlmerge eol=lf
*.prefab          merge=unityyamlmerge eol=lf
*.asset           merge=unityyamlmerge eol=lf
*.mat             merge=unityyamlmerge eol=lf
*.anim            merge=unityyamlmerge eol=lf
*.controller      merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.physicMaterial  merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.playable        merge=unityyamlmerge eol=lf
*.mask            merge=unityyamlmerge eol=lf
*.brush           merge=unityyamlmerge eol=lf
*.flare           merge=unityyamlmerge eol=lf
*.fontsettings    merge=unityyamlmerge eol=lf
*.guiskin         merge=unityyamlmerge eol=lf
*.giparams        merge=unityyamlmerge eol=lf
*.renderTexture   merge=unityyamlmerge eol=lf
*.cubemap         merge=unityyamlmerge eol=lf
*.mixer           merge=unityyamlmerge eol=lf
*.shadervariants  merge=unityyamlmerge eol=lf
*.terrainlayer    merge=unityyamlmerge eol=lf
*.signal          merge=unityyamlmerge eol=lf
*.spriteatlas     merge=unityyamlmerge eol=lf
*.spriteatlasv2   merge=unityyamlmerge eol=lf
*.lighting        merge=unityyamlmerge eol=lf

## .meta files are text and MUST be committed alongside their asset.
*.meta            merge=unityyamlmerge eol=lf

## Plain text
*.cs              text diff=csharp eol=lf
*.asmdef          text eol=lf
*.asmref          text eol=lf
*.json            text eol=lf
*.md              text eol=lf
*.txt             text eol=lf
*.xml             text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.shader          text eol=lf
*.hlsl            text eol=lf
*.cginc           text eol=lf
*.compute         text eol=lf
*.uxml            text eol=lf
*.uss             text eol=lf
*.inputactions    text eol=lf
*.gitattributes   text eol=lf
.gitignore        text eol=lf

## Windows-native scripts keep CRLF
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf

